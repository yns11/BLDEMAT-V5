# Copier vers un gestionnaire de secrets CI/CD ou exporter dans le shell.
# Ne jamais committer les valeurs réelles.
export DATABRICKS_HOST="https://dbc-xxxxxxxx-xxxx.cloud.databricks.com"
export BUNDLE_VAR_lakebase_branch="projects/xxx/branches/production"
export BUNDLE_VAR_lakebase_database="projects/xxx/branches/production/databases/xxx"
export BUNDLE_VAR_lakebase_endpoint="projects/xxx/branches/production/endpoints/xxx"
export BUNDLE_VAR_pg_host="ep-xxxx.database.cloud.databricks.com"
export BUNDLE_VAR_pg_database="databricks_postgres"
export BUNDLE_VAR_pg_schema="bl_demat"
export BUNDLE_VAR_documents_volume="main.bldemat.documents"
export BUNDLE_VAR_model_endpoint_name="mon-endpoint-vision"
export BUNDLE_VAR_jobs_service_principal="00000000-0000-0000-0000-000000000000"
export BUNDLE_VAR_creation_users_group="BLDEMAT-OPERATEURS"
export BUNDLE_VAR_administration_users_group="BLDEMAT-ADMIN-METIER"
export BUNDLE_VAR_administrators_group="BLDEMAT-TECH-ADMINS"
export BUNDLE_VAR_bootstrap_admins="prenom.nom@entreprise.fr"
export BUNDLE_VAR_erp_catalog="catalogue_erp"
export BUNDLE_VAR_erp_schema="schema_erp"
export BUNDLE_VAR_staging_catalog="catalogue_bldemat"
export BUNDLE_VAR_staging_schema="staging"
# Passer à true uniquement après validation de salesordernum et DespatchAdvice-Sales.
export BUNDLE_VAR_sales_desadv_enabled="false"
